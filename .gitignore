# Dependencies and build output (regenerated by `npm install` / the build) — never commit.
node_modules/
dist/
dist-electron/
release/
.vite/

# TypeScript / tooling caches
*.tsbuildinfo

# Native addon build output (node-gyp)
**/native/build/
*.node

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Self-contained mpv runtime (generated by scripts/bundle-linux.sh)
vendor/

# Windows libmpv dev files (downloaded by scripts/setup-windows.ps1)
**/native/mpv-dev/
**/native/vlc-sdk/
